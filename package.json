{
  "name": "cocoacad",
  "version": "0.2.0",
  "description": "CocoaCAD — parametric web CAD in the CocoaSuite family",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CocoaSuite/cocoacad.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/CocoaSuite/cocoacad/issues"
  },
  "homepage": "https://github.com/CocoaSuite/cocoacad#readme",
  "dependencies": {
    "@salusoft89/planegcs": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "replicad": "^1.2.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
